#include <limits.h> 
#include <stdio.h>
#define MAX 20
int V, E;
int graph[MAX][MAX];
#define INFINITY 99999

void dijkstra(int G[MAX][MAX], int n, int startnode) {
	
	
    int distance[MAX];
    int visited[MAX];
    int parent[MAX];

    // Initialize
    for (int i = 1; i <= n; i++) {
        distance[i] = INFINITY;
        visited[i] = 0;
        parent[i] = -1;
    }

    distance[startnode] = 0;

    // Dijkstra's algorithm
    for (int count = 1; count <= n; count++) {

        int min = INFINITY;
        int u = -1;

        // Find closest unvisited node
        for (int i = 1; i <= n; i++) {
            if (!visited[i] && distance[i] < min) {
                min = distance[i];
                u = i;
            }
        }

        // No more reachable nodes
        if (u == -1)
            break;

        visited[u] = 1;

        // Update neighbors
        for (int v = 1; v <= n; v++) {
            if (G[u][v] != 0 &&
                !visited[v] &&
                distance[u] + G[u][v] < distance[v]) {

                distance[v] = distance[u] + G[u][v];
                parent[v] = u;
            }
        }
    }

    printf("Node\tDistance\tPath\n");

    // Print result
    for (int i = 1; i <= n; i++) {
        if (i == startnode)
            continue;

        printf("%4d\t", i);

        if (distance[i] == INFINITY) {
            printf("     INF\tNO PATH\n");
        } else {
            printf("%8d\t", distance[i]);

            int path[MAX];
            int count = 0;
            int current = i;

            while (current != -1) {
                path[count++] = current;
                current = parent[current];
            }

            for (int j = 0; j < count; j++) {
                if (j > 0)
                    printf("<-");
                printf("%d", path[j]);
            }

            printf("\n");
        }
    }

	
}
int main() { 
	int s, d, w, i, j;
	printf("Enter the number of vertices : ");
	scanf("%d", &V);
	printf("Enter the number of edges : ");
	scanf("%d", &E);
	for(i = 1 ; i <= V; i++) {
		for(j = 1; j <= V; j++) {
			graph[i][i] = 0;
		}
	}
	for(i = 1; i <= E; i++) {
		printf("Enter source : ");
		scanf("%d", &s);
		printf("Enter destination : ");
		scanf("%d", &d);
		printf("Enter weight : ");
		scanf("%d", &w);
		if(s > V || d > V || s <= 0 || d <= 0) {
			printf("Invalid index. Try again.\n");
			i--;
			continue;
		} else {
			graph[s][d] = w;
		}
	}
	printf("Enter the source :");
	scanf("%d", &s);
	dijkstra(graph, V, s); 
	return 0; 
} 
