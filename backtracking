#include <stdio.h>
#include <stdlib.h>

int n, target;
int arr[64];
unsigned long long *found;
int cnt = 0, cap = 16;

void solve(int idx, int sum, unsigned long long mask) {
    if (idx == n) {
        if (sum == target && mask != 0) {
            if (cnt == cap) {
                cap *= 2;
                found = (unsigned long long *)realloc(found, cap * sizeof(unsigned long long));
            }
            found[cnt++] = mask;
        }
        return;
    }
    solve(idx + 1, sum + arr[idx], mask | (1ULL << idx)); // include
    solve(idx + 1, sum, mask);                             // exclude
}

int main() {
    scanf("%d", &n);
    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);
    scanf("%d", &target);

    found = (unsigned long long *)malloc(cap * sizeof(unsigned long long));
    solve(0, 0, 0);

    if (cnt == 0) {
        printf("-1\n");
    } else {
        for (int k = cnt - 1; k >= 0; k--) {
            for (int i = 0; i < n; i++)
                if (found[k] & (1ULL << i))
                    printf("%d ", arr[i]);
            printf("\n");
        }
    }
    free(found);
    return 0;
}
