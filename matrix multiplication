#include <stdio.h>
#include <stdlib.h>

int main() {
    int r1, c1, r2, c2;

    scanf("%d %d", &r1, &c1);
    int **A = (int **)malloc(r1 * sizeof(int *));
    for (int i = 0; i < r1; i++) {
        A[i] = (int *)malloc(c1 * sizeof(int));
        for (int j = 0; j < c1; j++)
            scanf("%d", &A[i][j]);
    }

    scanf("%d %d", &r2, &c2);
    if (c1 != r2) {
        printf("Invalid input\n");
        return 0;
    }

    int **B = (int **)malloc(r2 * sizeof(int *));
    for (int i = 0; i < r2; i++) {
        B[i] = (int *)malloc(c2 * sizeof(int));
        for (int j = 0; j < c2; j++)
            scanf("%d", &B[i][j]);
    }

    for (int i = 0; i < r1; i++) {
        for (int j = 0; j < c2; j++) {
            long long sum = 0;
            for (int k = 0; k < c1; k++)
                sum += (long long)A[i][k] * B[k][j];
            printf("%lld ", sum);
        }
        printf("\n");
    }

    for (int i = 0; i < r1; i++) free(A[i]);
    for (int i = 0; i < r2; i++) free(B[i]);
    free(A);
    free(B);
    return 0;
}
